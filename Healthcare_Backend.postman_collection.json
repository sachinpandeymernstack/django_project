						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.access);",
									"    console.log('Access token automatically saved to collection variable.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
